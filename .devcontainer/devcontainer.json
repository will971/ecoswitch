{
  "name": "ecoswitch",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "runArgs": [
    "--privileged"
  ],
  "remoteUser": "node",
  "containerEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "mounts": [
    "source=/home/debian/.claude,target=/home/node/.claude,type=bind",
    "source=/home/debian/.claude.json,target=/home/node/.claude.json,type=bind",
    "source=/home/debian/devcontainer-bin,target=/usr/local/devcontainer-bin,type=bind,readonly"
  ],
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && bash /usr/local/devcontainer-bin/setup-gh.sh"
}
