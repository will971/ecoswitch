# =================================================================
# EcoSwitch — variables de production (docker-compose.prod.yml)
# Copier en .env et renseigner. Ne JAMAIS commiter le .env.
# =================================================================

# Port public de l'interface web
PORT=80

# ── Base de donnees ───────────────────────────────────────────────
POSTGRES_DB=ecoswitch
POSTGRES_USER=ecoswitch
POSTGRES_PASSWORD=

# ── Authentification (better-auth) ────────────────────────────────
# Obligatoire, sans valeur par defaut. Generer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'API
BETTER_AUTH_URL=https://api.example.fr
# Comptes promus ADMIN au demarrage (emails separes par des virgules).
# Remplace la liste d'emails autrefois codee en dur dans le Java.
ECOSWITCH_BOOTSTRAP_ADMIN_EMAILS=

# ── Connexion Google (facultatif) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Conseiller IA et resume des prix (facultatif) ─────────────────
# Sans cle, un moteur de regles local prend le relais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── Images ────────────────────────────────────────────────────────
# Par defaut, le stockage S3 de la stack (RustFS) ; Nginx le sert sous /media/.
# Ces identifiants sont ceux du stockage ET ceux qu'utilise l'API.
S3_ACCESS_KEY=ecoswitch
# Generer avec : openssl rand -base64 24
S3_SECRET_KEY=
# URL publique des images, vue par le navigateur (sans / final)
S3_PUBLIC_BASE_URL=https://www.example.fr/media
MAX_UPLOAD_MB=5

# Pour un bucket OVH Object Storage a la place, decommenter et renseigner
# (le bucket doit deja exister et etre en lecture publique) :
# S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# S3_REGION=gra
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://<bucket>.s3.gra.io.cloud.ovh.net
# S3_AUTO_CREATE_BUCKET=false

# ── Securite ──────────────────────────────────────────────────────
# Origines autorisees a appeler l'API, separees par des virgules.
CORS_ALLOWED_ORIGINS=https://www.example.fr
