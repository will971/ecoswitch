# =================================================================
# Fichier d'exemple d'environnement de production — EcoSwitch
# Copiez ce fichier en '.env' et modifiez les valeurs secrètes.
# =================================================================

# Port d'écoute public de l'interface web (ex: 80 pour HTTP standard, ou 3000 si derrière Nginx/Caddy/Cloudflare)
PORT=80

# Base de données PostgreSQL
POSTGRES_DB=ecoswitch
POSTGRES_USER=ecoswitch
POSTGRES_PASSWORD=ChangeThisPasswordInProduction!123

# Clé secrète JWT (Base64 HMAC-SHA256, 256 bits minimum)
# Vous pouvez en générer une avec : openssl rand -base64 32
JWT_SECRET=RWNvU3dpdGNoU2VjcmV0S2V5MjAyNlByZW1pdW1BcHBKd3RTZWNVcmVUb2tlbg==

# Compte d'administration (/admin)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=ChangeThisAdminPasswordNow!2026

# Intégrations optionnelles
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Origines CORS autorisées (séparées par une virgule, ou * pour tout autoriser)
CORS_ALLOWED_ORIGINS=*
